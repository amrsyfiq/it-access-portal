# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Read by docker compose (container setup) and by the Spring Boot backend (spring.config.import).

# --- Oracle (docker compose creates this app user inside FREEPDB1 on first start) ---
ORACLE_PASSWORD=change-me-sys-password
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=portal
DB_PASSWORD=change-me-app-password

# --- HikariCP (optional overrides) ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# --- Kafka (Phase 3) ---
# Local single-node broker without authentication (see docker-compose.yml); no credentials needed.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Demo only: notifications for this system name fail (retries, then dead-letter topic) ---
NOTIFICATIONS_FAIL_FOR_SYSTEM=Legacy Mainframe
