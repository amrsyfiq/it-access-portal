# Template for .env. Easiest: node infra/init-env.mjs  (creates .env with random secrets).
# .env is git-ignored; never commit real values.
# Read by docker compose (container setup) and by the Spring Boot backend (spring.config.import).

# --- Oracle (docker compose creates this app user inside FREEPDB1 on first start) ---
ORACLE_PASSWORD=change-me-sys-password
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=portal
DB_PASSWORD=change-me-app-password

# --- HikariCP (optional overrides) ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# --- Kafka (Phase 3) ---
# Local single-node broker without authentication (see docker-compose.yml); no credentials needed.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Demo only: notifications for this system name fail (retries, then dead-letter topic) ---
NOTIFICATIONS_FAIL_FOR_SYSTEM=Legacy Mainframe

# --- WSO2 API Manager (Phase 4, docker compose --profile gateway) ---
WSO2_ADMIN_PASSWORD=change-me-wso2-admin
# 32 hex characters, e.g.: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
WSO2_ENCRYPTION_KEY=change-me-32-hex-characters-0000
# Demo users created in WSO2 by infra/wso2/setup.mjs (5-30 characters, no spaces)
PORTAL_EMPLOYEE_PASSWORD=change-me-ted
PORTAL_ADMIN_PASSWORD=change-me-alice
